---
import Layout from '../layouts/Layout.astro';
import Icons from '../components/Icons.astro';
---
<Layout title="Page introuvable – B.R.F.B services" description="Cette page n'existe pas ou a été déplacée.">
  <section class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Erreur 404</span>
      <h1>Page <em>introuvable</em></h1>
      <p class="lead">Cette page n'existe pas ou a été déplacée. Retrouvez nos produits ou contactez-nous directement.</p>
      <p style="margin-top:28px;display:flex;gap:12px;flex-wrap:wrap">
        <a class="btn btn-yellow" href="/">Retour à l'accueil <Icons name="arrow" /></a>
        <a class="btn btn-ghost" href="/produits/">Voir les produits</a>
      </p>
    </div>
  </section>
</Layout>
