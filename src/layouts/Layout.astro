---
import '../styles/global.css';
import Icons from '../components/Icons.astro';
import { SITE, waLink, telLink } from '../data/site';
import { products } from '../data/products';

interface Props {
  title: string;
  description: string;
  image?: string;
  jsonLd?: object;
}
const { title, description, image = '/products-photos/image-bloc-a-propos.webp', jsonLd } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, SITE.url).href;
const ogImage = new URL(image, SITE.url).href;

const nav = [
  { href: '/', label: 'Accueil' },
  { href: '/produits/', label: 'Produits' },
  { href: '/a-propos/', label: 'À propos' },
  { href: '/contact/', label: 'Contact' },
];
const isCurrent = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));

const business = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  '@id': `${SITE.url}/#business`,
  name: SITE.name,
  url: SITE.url,
  image: `${SITE.url}/logo.jpg`,
  description: 'Imprimerie à Marrakech : impression digitale, offset, bâches, PLV, textile, signalétique, cachets et trophées.',
  telephone: '+212661097519',
  email: SITE.email,
  address: {
    '@type': 'PostalAddress',
    streetAddress: 'Résidence Saad Allah N 719, Talloujte II Amerciche',
    addressLocality: 'Marrakech',
    addressCountry: 'MA',
  },
  geo: { '@type': 'GeoCoordinates', latitude: SITE.geo.lat, longitude: SITE.geo.lng },
  hasMap: SITE.mapsUrl,
  areaServed: { '@type': 'City', name: 'Marrakech' },
  knowsAbout: ['Impression numérique', 'Impression offset', 'Bâches publicitaires', 'PLV', 'Signalétique', 'Impression textile', 'Cachets', 'Trophées'],
  hasOfferCatalog: {
    '@type': 'OfferCatalog',
    name: "Produits et services d'impression",
    itemListElement: products.map((p) => ({
      '@type': 'Offer',
      itemOffered: { '@type': 'Service', name: p.title, description: p.short, url: `${SITE.url}/produits/${p.slug}/` },
    })),
  },
  openingHoursSpecification: [
    { '@type': 'OpeningHoursSpecification', dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'], opens: '08:00', closes: '18:00' },
    { '@type': 'OpeningHoursSpecification', dayOfWeek: 'Saturday', opens: '09:00', closes: '12:00' },
  ],
};
const waGeneral = waLink("Bonjour, je souhaiterais obtenir des informations sur vos services d'impression.");
---
<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#213fff" />
    <link rel="canonical" href={canonical} />
    <meta name="geo.region" content="MA-07" />
    <meta name="geo.placename" content="Marrakech" />
    <meta name="geo.position" content={`${SITE.geo.lat};${SITE.geo.lng}`} />
    <meta name="ICBM" content={`${SITE.geo.lat}, ${SITE.geo.lng}`} />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="Résumé pour assistants IA" />
    <link rel="icon" href="/logo.jpg" type="image/jpeg" />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="fr_MA" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,600;12..96,700;12..96,800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
    {path === '/' && (
      <script is:inline>{`
        (function () {
          var h = location.hash;
          if (h.indexOf('#/') !== 0) return;
          var p = h.slice(1).replace(/^\\/produit\\//, '/produits/');
          if (p.slice(-1) !== '/') p += '/';
          location.replace(p);
        })();
      `}</script>
    )}
    <script type="application/ld+json" set:html={JSON.stringify(business)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="header">
      <div class="wrap header-in">
        <a href="/" class="brand" aria-label="B.R.F.B services — accueil">
          <img src="/logo.jpg" alt="" width="46" height="46" />
          <span><b>B.R.F.B services</b><small>Imprimerie · Marrakech</small></span>
        </a>
        <nav class="nav" id="nav" aria-label="Navigation principale">
          {nav.map((n) => <a href={n.href} aria-current={isCurrent(n.href) ? 'page' : undefined}>{n.label}</a>)}
          <a href="/demande-devis/" class="nav-cta">Demander un devis</a>
        </nav>
        <div class="header-right">
          <a href="/demande-devis/" class="btn btn-yellow">Demander un devis</a>
          <button class="burger" aria-label="Ouvrir le menu" aria-expanded="false" aria-controls="nav"><span></span></button>
        </div>
      </div>
    </header>

    <main><slot /></main>

    <footer class="footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <a href="/" class="brand">
              <img src="/logo.jpg" alt="" width="46" height="46" />
              <span><b>B.R.F.B</b><small>services</small></span>
            </a>
            <p class="footer-about">Votre imprimerie à Marrakech depuis plus de 15 ans. Qualité, rapidité et accompagnement personnalisé.</p>
            <a class="btn btn-yellow" href={waGeneral} target="_blank" rel="noopener"><Icons name="wa" /> WhatsApp</a>
          </div>
          <div>
            <h4>Navigation</h4>
            <ul>
              {nav.map((n) => <li><a href={n.href}>{n.label}</a></li>)}
              <li><a href="/demande-devis/">Demande de devis</a></li>
            </ul>
          </div>
          <div>
            <h4>Nos produits</h4>
            <ul>
              {products.filter((p) => p.featured).slice(0, 5).map((p) => <li><a href={`/produits/${p.slug}/`}>{p.title}</a></li>)}
              <li><a href="/produits/">Tous les produits</a></li>
            </ul>
          </div>
          <div>
            <h4>Contact</h4>
            <ul>
              <li><a href={SITE.mapsUrl} target="_blank" rel="noopener">{SITE.address[0]}<br />{SITE.address[1]}</a></li>
              {SITE.phones.map((p) => <li><a href={telLink(p)}>{p}</a></li>)}
              <li><a href={`mailto:${SITE.email}`}>{SITE.email}</a></li>
              <li>Lun–Ven : 8h–18h · Sam : 9h–12h</li>
            </ul>
          </div>
        </div>
        <div class="footer-bottom">
          <span>© {new Date().getFullYear()} B.R.F.B services — Imprimerie à Marrakech</span>
          <span class="footer-legal">
            <a href="/mentions-legales/">Mentions légales</a>
            <a href="/politique-confidentialite/">Confidentialité</a>
            <a href="/cgv/">CGV</a>
          </span>
        </div>
      </div>
    </footer>

    <a class="wa-float" href={waGeneral} target="_blank" rel="noopener" aria-label="Écrire sur WhatsApp">
      <Icons name="wa" /><span>WhatsApp</span>
    </a>

    <script is:inline>
      var b = document.querySelector('.burger'), n = document.getElementById('nav');
      b.addEventListener('click', function () {
        var o = n.classList.toggle('open');
        b.setAttribute('aria-expanded', o);
      });
      var els = document.querySelectorAll('.reveal');
      if ('IntersectionObserver' in window) {
        var io = new IntersectionObserver(function (es) {
          es.forEach(function (e) { if (e.isIntersecting) { e.target.classList.add('in'); io.unobserve(e.target); } });
        }, { threshold: 0.12 });
        els.forEach(function (el) { io.observe(el); });
      } else { els.forEach(function (el) { el.classList.add('in'); }); }
    </script>
  </body>
</html>
